# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다(.gitignore).
# 공공데이터포털 마이페이지 > 일반 인증키(Decoding) 값
DATA_GO_KR_SERVICE_KEY=
# 법제처 국가법령정보 공동활용 OPEN API 신청 시 지정한 OC 값
LAW_GO_KR_OC=
# 전파 적합성평가(국립전파연구원, data.go.kr 3034183)는 키가 필요 없는 공개 API라 위 키 없이도 조회됩니다.

# --- 저장소(영속화) 설정: 비워 두면 기본값을 씁니다 -------------------------------
# 작업 DB 경로 우선순위: CLNS_DB_PATH > IMPORT_COMPLIANCE_DB > DATABASE_URL(sqlite://) > data/app.sqlite
# 영구 볼륨을 붙이는 환경에서는 이 값을 볼륨 경로로 지정하세요(예: /app/data/app.sqlite).
CLNS_DB_PATH=
# 기동 시 복원할 일일 스냅샷 폴더(기본 data/snapshots). 비우면 기본값.
CLNS_SEED_DIR=
# 기동 시 복원할 익명 사용 통계 파일(기본 data/usage/stats.json). 비우면 기본값.
CLNS_USAGE_SEED=
# DATABASE_URL 은 sqlite:///경로 형식만 작업 DB로 해석합니다. postgres:// 는 표준 라이브러리
# 이미지에 드라이버가 없어 쓰지 않고, 기동 로그에 미지원 사실을 남깁니다.
DATABASE_URL=

# --- 문의 접수 유실 대비 (0.5.3) ---------------------------------------------
# 접수 저널 경로(기본: DB 옆 data/inquiries.jsonl). 이 파일에는 신청자 연락처가 평문으로
# 들어 있으므로 커밋하지 않습니다(.gitignoreㆍ.dockerignore). "off" 로 두려면 값을 비우세요.
CLNS_INQUIRY_JOURNAL=
# 새 문의가 들어오면 이 주소로 JSON 을 POST 합니다(운영자 본인 채널만 넣으세요).
# 본문에는 회신용 연락처가 포함됩니다. 마스킹본만 받으려면 아래 값을 1 로 둡니다.
CLNS_INQUIRY_WEBHOOK_URL=
CLNS_INQUIRY_WEBHOOK_EXCLUDE_CONTACT=
# 관리자용 문의 요약(GET /v1/inquiry/summary)을 열려면 긴 임의 문자열을 넣고
# 요청에 X-Admin-Token 헤더로 같은 값을 보냅니다. 비우면 경로가 404 입니다.
CLNS_ADMIN_TOKEN=

# --- 티어ㆍ요청 제한 (0.5.3) --------------------------------------------------
# 유료 티어는 아직 판매하지 않습니다. 서버가 발급한 키를 여기에 쉼표로 나열하고,
# 요청에 X-Api-Key(또는 Authorization: Bearer)로 제시할 때만 X-Tier 가 인정됩니다.
# 키가 없으면 X-Tier 헤더는 무시되고 무료 한도(월 250회)가 그대로 적용됩니다.
CLNS_PRO_API_KEYS=
# HTTP 요청 제한(분당). 일반 경로 기본 120, 툴ㆍMCPㆍ문의 경로 기본 60.
CLNS_RATE_LIMIT_PER_MIN=
CLNS_TOOL_RATE_LIMIT_PER_MIN=
